DATABASE_URL=postgresql+asyncpg://localhost:5432/pingcrm
REDIS_URL=redis://localhost:6379/0
# REQUIRED: Generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
# REQUIRED: Generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=
# Set to "production" in production deployments (enforces mandatory security checks)
ENVIRONMENT=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/auth/twitter/callback
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
ANTHROPIC_API_KEY=

# LLM provider. The provider is detected from the model's prefix:
# anthropic/ | openai/ | ollama/ | vllm/
# Anthropic is the default. LLM_API_KEY takes precedence over ANTHROPIC_API_KEY
# for Anthropic and is the only key used for OpenAI-compatible providers.
LLM_API_KEY=
# Base URL for OpenAI-compatible servers (OpenAI, Ollama, vLLM, ...).
# Leave blank for the provider default; for a local Ollama use
# http://localhost:11434/v1. Must be reachable from the backend/worker.
LLM_BASE_URL=
LLM_MODEL_DRAFT=anthropic/claude-sonnet-4-6
LLM_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
# Only for self-hosted, no-auth OpenAI-compatible servers on localhost or a
# trusted LAN. Never enable this for a remote endpoint that requires auth.
LLM_ALLOW_EMPTY_KEY=false
# Per-provider concurrency cap shared by every service using that config.
# Set to 10 to match the previous combined peak across event_classifier and
# auto_tagger.
LLM_MAX_CONCURRENCY=5

# Bird CLI — Twitter/X cookie-based access (optional)
# Extract from browser: DevTools → Application → Cookies → x.com
AUTH_TOKEN=
CT0=
