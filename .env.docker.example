# Database
POSTGRES_PASSWORD=changeme

# App secrets
SECRET_KEY=changeme-generate-a-random-string

# AI / LLM provider (Anthropic Claude by default)
ANTHROPIC_API_KEY=
# The provider is chosen from the model prefix:
# anthropic/ | openai/ | ollama/ | vllm/
LLM_API_KEY=
# OpenAI-compatible base URL; blank uses the provider default. For a local
# Ollama use http://ollama:11434/v1 (Compose service name) or a LAN IP.
LLM_BASE_URL=
LLM_MODEL_DRAFT=anthropic/claude-sonnet-4-6
LLM_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
# Only for self-hosted, no-auth OpenAI-compatible servers on localhost/LAN.
LLM_ALLOW_EMPTY_KEY=false
# Set to 10 to match prior peak concurrency across event_classifier +
# auto_tagger.
LLM_MAX_CONCURRENCY=5

# Gmail OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter/X OAuth (optional)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Telegram MTProto (optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
